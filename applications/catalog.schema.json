{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencenter.dev/catalog.schema.json",
  "title": "openCenter Catalog ServiceEntry",
  "description": "Schema for a per-service catalog.yaml fragment under applications/base/services/<service>/catalog.yaml. See docs/catalog/schema.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "name", "path", "packaging"],
  "properties": {
    "apiVersion": {
      "const": "catalog.opencenter.dev/v1alpha1"
    },
    "kind": {
      "const": "ServiceEntry"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Catalog key. Lowercase, digits, hyphens. Unique across the catalog."
    },
    "path": {
      "type": "string",
      "pattern": "^applications/base/services/[a-z0-9][a-z0-9./-]*$",
      "description": "Repository-relative service directory path. The only place this string is authored."
    },
    "packaging": {
      "type": "string",
      "enum": ["helmRepository", "ociHelm", "gitRepository", "olmSubscription", "remoteKustomize", "composite"]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing one-line purpose, used in generated documentation."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Single source of truth for the service version. Required unless packaging is composite."
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["crds", "storageclass", "extra"] },
          "version": { "type": "string", "minLength": 1 },
          "versionWaiver": { "type": "string", "minLength": 1 }
        }
      }
    },
    "subcomponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "deployable"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["component", "prerequisite"] },
          "deployable": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "packaging": {
            "type": "string",
            "enum": ["helmRepository", "ociHelm", "gitRepository", "olmSubscription", "remoteKustomize", "customResources"]
          },
          "version": { "type": "string", "minLength": 1 },
          "namespace": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 }
            }
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["crds", "storageclass", "extra"] },
                "version": { "type": "string", "minLength": 1 },
                "versionWaiver": { "type": "string", "minLength": 1 }
              }
            }
          },
          "requires": { "type": "array", "items": { "type": "string" } },
          "blueprints": { "$ref": "#/definitions/blueprintMembership" },
          "versionWaiver": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deployableAsUnit": { "type": "boolean" },
    "blueprints": { "$ref": "#/definitions/blueprintMembership" },
    "requires": { "type": "array", "items": { "type": "string" } },
    "maturity": { "type": "string", "enum": ["stable", "beta", "alpha"] },
    "defaultEnabled": { "type": "boolean" },
    "renderOwner": { "type": "string", "enum": ["renderCatalog", "descriptor", "none"] },
    "versionWaiver": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "blueprintMembership": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tier"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "tier": { "type": "string", "enum": ["required", "recommended", "optional"] },
          "defaultEnabled": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "packaging": { "const": "composite" } } },
      "then": { "required": ["subcomponents"] },
      "else": { "required": ["version"] }
    },
    {
      "if": {
        "properties": {
          "packaging": { "enum": ["helmRepository", "ociHelm", "gitRepository"] }
        }
      },
      "then": { "required": ["source", "namespace"] }
    }
  ]
}
